
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Helpdesk Portal</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>Malla Reddy University</h1>
        <p>Student Helpdesk & Circular Portal</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#circulars">Circulars</a>
        <a href="#exams">Exams</a>
        <a href="#announcements">Announcements</a>
        <a href="#contact">Contact</a>
    </nav>

    <main>
        <section class="welcome" id="home">
            <h2>Welcome to Student Helpdesk</h2>
            <p>Your one-stop destination for academic updates,
               circulars and university information.</p>
        </section>

        <div class="container">

            <section id="circulars">
                <h2>Academic Circulars</h2>
                <div class="cards">

                    <article class="card">
                        <h3>Academic Notice</h3>
                        <p>Important academic updates for students.</p>
                        <a href="#contact">View Details</a>
                    </article>

                    <article class="card">
                        <h3>Attendance Notice</h3>
                        <p>Check attendance-related announcements.</p>
                        <a href="#contact">View Details</a>
                    </article>

                </div>
            </section>

            <section id="exams">
                <h2>Examination Notifications</h2>
                <div class="cards">

                    <article class="card">
                        <h3>Exam Schedule</h3>
                        <p>Check upcoming examination information.</p>
                        <a href="#contact">View Details</a>
                    </article>

                    <article class="card">
                        <h3>Results Updates</h3>
                        <p>Stay updated with examination results.</p>
                        <a href="#contact">View Details</a>
                    </article>

                </div>
            </section>

            <section id="announcements">
                <h2>Campus Announcements</h2>
                <div class="cards">

                    <article class="card">
                        <h3>Campus Events</h3>
                        <p>Get updates about university events.</p>
                    </article>

                    <article class="card">
                        <h3>Workshops</h3>
                        <p>Know about upcoming workshops and activities.</p>
                    </article>

                </div>
            </section>

            <section id="resources">
                <h2>Important Links & Resources</h2>
                <div class="card">
                    <p>
                        <a href="https://www.mallareddyuniversity.ac.in/"
                           target="_blank" rel="noopener">
                           University Official Website
                        </a>
                    </p>

                    <p><a href="#contact">Academic Resources</a></p>
                    <p><a href="#contact">Student Support</a></p>
                </div>
            </section>

            <section class="enquiry" id="contact">
                <h2>Student Enquiry Form</h2>

                <form id="enquiryForm">

                    <label for="name">Student Name:</label>
                    <input type="text" id="name" name="name" required>

                    <label for="email">Email Address:</label>
                    <input type="email" id="email" name="email" required>

                    <label for="department">Department:</label>
                    <select id="department" name="department" required>
                        <option value="">Select Department</option>
                        <option>CSE</option>
                        <option>ECE</option>
                        <option>EEE</option>
                        <option>Mechanical</option>
                        <option>Other</option>
                    </select>

                    <label for="type">Enquiry Type:</label>
                    <select id="type" name="type" required>
                        <option value="">Select Enquiry</option>
                        <option>Academic</option>
                        <option>Examination</option>
                        <option>Fees</option>
                        <option>General</option>
                    </select>

                    <label for="message">Your Message:</label>
                    <textarea id="message" name="message"
                              rows="4" required></textarea>

                    <button type="submit">Submit Enquiry</button>

                </form>
            </section>

        </div>
    </main>

    <footer>
        <p>&copy; 2026 Malla Reddy University</p>
        <p>Student Helpdesk & Circular Portal</p>
    </footer>

    <!-- External JavaScript -->
    <script src="script.js"></script>

</body>
</html>
